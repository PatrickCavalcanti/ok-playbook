{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PatrickCavalcanti/ok-playbook/install/ok-playbook.config.schema.json",
  "title": "ok-playbook config",
  "description": "Configuração do consumidor do ok-playbook. Define os paths que substituem placeholders dos patterns/agentes do playbook.",
  "type": "object",
  "required": ["version", "paths"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "description": "Versão do ok-playbook em uso. Atualizada pelo CLI quando init é re-executado contra versão mais nova.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9.-]+)?$"
    },
    "paths": {
      "type": "object",
      "description": "Mapeamento de placeholders do playbook para paths reais deste projeto. Todos relativos ao root do projeto consumidor; devem ser diretórios terminados em '/'.",
      "required": ["docs", "arch", "agents", "superpowers", "backlog", "drafts", "insights"],
      "additionalProperties": false,
      "properties": {
        "docs": {
          "type": "string",
          "description": "Resolve <docs-root>. Default: 'docs/'"
        },
        "arch": {
          "type": "string",
          "description": "Resolve <arch-root>. Default: 'docs/project-architecture/'"
        },
        "agents": {
          "type": "string",
          "description": "Resolve <agents-root>. Default: 'docs/project-architecture/agents/'"
        },
        "superpowers": {
          "type": "string",
          "description": "Resolve <superpowers-root>. Default: 'docs/superpowers/'"
        },
        "backlog": {
          "type": "string",
          "description": "Resolve <backlog-root>. Default: 'docs/agent-feedback/'"
        },
        "drafts": {
          "type": "string",
          "description": "Resolve <drafts-root>. Default: 'docs/_drafts/'"
        },
        "insights": {
          "type": "string",
          "description": "Resolve <insights-root>. Default: 'docs/insights/'"
        }
      }
    }
  },
  "examples": [
    {
      "$schema": "./node_modules/ok-playbook/install/ok-playbook.config.schema.json",
      "version": "0.1.0",
      "paths": {
        "docs": "docs/",
        "arch": "docs/project-architecture/",
        "agents": "docs/project-architecture/agents/",
        "superpowers": "docs/superpowers/",
        "backlog": "docs/agent-feedback/",
        "drafts": "docs/_drafts/",
        "insights": "docs/insights/"
      }
    }
  ]
}
