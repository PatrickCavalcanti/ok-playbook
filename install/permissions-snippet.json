{
  "_comment": "Permissões path-agnostic + hook canônico do ok-playbook. Para mesclar em .claude/settings.json do projeto consumidor (§5 de INSTALL.md). O bloco hooks registra o PreToolUse de auto-approve-worktree-bash.js (template em install/hooks/) — INSTALL copia o JS pra .claude/hooks/ substituindo <PROJECT_PATH>. Variantes path-specific de worktree NÃO existem mais aqui — viraram hook (ver patterns/worktree.md §6.2).",

  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(tsx *)",
      "Bash(tsc *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(sed *)",
      "Bash(wc *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(touch *)",
      "Bash(echo *)",
      "Bash(cmd //c \"mklink *\")",
      "Bash(cmd /c mklink *)",
      "Bash(git worktree *)",
      "Bash(git -C *.worktrees/* *)",
      "Bash(git -C *.worktrees\\* *)",
      "Bash(rm -rf *.worktrees/*)",
      "PowerShell(New-Item *)",
      "PowerShell(Remove-Item *.worktrees*)",
      "WebSearch"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/auto-approve-worktree-bash.js"
          }
        ]
      }
    ]
  }
}
